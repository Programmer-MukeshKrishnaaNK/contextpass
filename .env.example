# ContextPass — environment template
#
#   cp .env.example .env.local
#
# Then replace every your_… placeholder. .env.local is git-ignored; never commit it.
# Optional variables are commented out: leave them that way unless you need them,
# because an uncommented placeholder would be read as a real value.

# ══ Public (browser) ══════════════════════════════════════════════════════════
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# Never put a secret in a NEXT_PUBLIC_ variable.

# Privy dashboard → App settings → App ID. Identifies the app to Privy; not a secret.
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Optional: a Privy app client ID, only if you use per-environment app clients.
# NEXT_PUBLIC_PRIVY_CLIENT_ID=your_privy_client_id

# The deployed ContextPassPermissions contract (public, on Monad Testnet).
# To use your own deployment, see contracts/README.md.
NEXT_PUBLIC_CONTEXTPASS_CONTRACT_ADDRESS=0xD6CEB04bC6C4F6c4b3AD3Ef742Dd0615B0eA248f

# "true" asks Privy to sponsor gas for Allow / Revoke. Requires gas sponsorship
# (including client-side sponsorship) enabled for Monad Testnet in the Privy
# dashboard. With "false", the user's embedded wallet needs testnet MON.
NEXT_PUBLIC_PRIVY_SPONSOR_GAS=false

# Optional overrides. Defaults: Monad Testnet, chain 10143, https://testnet-rpc.monad.xyz
# NEXT_PUBLIC_MONAD_CHAIN_ID=10143
# NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# ══ Server-only secrets ═══════════════════════════════════════════════════════
# Read only by src/lib/server/* and scripts/. They never reach the browser.
# Never prefix these with NEXT_PUBLIC_.

# Privy dashboard → App settings → App secret.
# Used to look up the signed-in user's embedded wallet. Access tokens themselves
# are verified against Privy's public keys.
PRIVY_APP_SECRET=your_privy_app_secret

# Supabase → Project settings → API.
# The project URL (https://<project-ref>.supabase.co) and the service-role key.
# The service-role key bypasses row-level security, so the server scopes every
# query to the verified owner itself.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase → Connect → Postgres connection string (session pooler or direct).
# Used only by `npm run db:migrate`, never by the running app.
SUPABASE_DB_URL=your_supabase_postgres_connection_string
