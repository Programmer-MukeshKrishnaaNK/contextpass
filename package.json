{
  "name": "contextpass",
  "version": "0.1.0",
  "license": "MIT",
  "description": "A user-controlled permission layer for AI applications: personal context in a private vault, permissions recorded on Monad, every read checked on-chain.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "vitest run supabase/tests",
    "test:contracts": "cd contracts && forge test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@privy-io/react-auth": "^3.47.0",
    "@supabase/supabase-js": "^2.117.3",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "viem": "2.56.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
